library(tidyverse)
set.seed(42)
poison_data <- tibble(
poison = rep(c("Poison 1", "Poison 2", "Poison 3"), each = 16),
treat = rep(rep(c("Treatment A", "Treatment B", "Treatment C", "Treatment D"), each = 4), times = 3),
time = c(
rnorm(16, mean = 0.32, sd = 0.08),
rnorm(16, mean = 0.55, sd = 0.10),
rnorm(16, mean = 0.75, sd = 0.12)
)
)
poison_data
poison_data %>%
ggplot() +
aes(x= poison, y = time)
poison_data %>%
ggplot() +
aes(x= poison, y = time) +
geom_boxplot()
poison_data %>%
ggplot() +
aes(x= poison, y = time) +
geom_boxplot() +
geom_jitter()
